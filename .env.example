# ───────── 고객 화면 (브라우저 번들에 포함되는 값: VITE_ 접두사) ─────────
# 카카오 Developers > 내 애플리케이션 > 앱 키 > "JavaScript 키"
# 브라우저에 노출되는 키입니다. 반드시 사용 도메인 제한(플랫폼 > Web 사이트 도메인)을 설정하세요.
# REST API 키·Admin 키는 절대 VITE_ 변수에 넣지 마세요.
VITE_KAKAO_MAP_JAVASCRIPT_KEY=

# 데이터 모드: demo(가상 상호 데모 데이터) | live(운영 저장소의 게시 승인 업소만)
VITE_DATA_MODE=demo

# 서비스 이름(미설정 시 src/config/site.ts 기본값)
VITE_SITE_NAME=호수공원 옆, 오늘의 한 곳

# QR에 들어갈 실제 배포 주소(운영자가 관리하는 고정 도메인 권장). 끝에 / 없이.
# 비어 있거나 localhost면 관리자 QR 화면에 "미리보기"로 표시됩니다.
VITE_PUBLIC_BASE_URL=

# (선택) 서버 없이 정적 호스팅할 때 공개 JSON 주소. 비우면 /api/public/* 사용
# 예: /data/public.json  (npm run export:public 으로 생성)
VITE_PUBLIC_DATA_URL=

# (선택) 이벤트 전송. 비우면 개발 모드 콘솔 로그만 남고 수집하지 않습니다.
# 이 프로젝트 서버를 쓸 경우: /api/events
VITE_ANALYTICS_ENDPOINT=

# ───────── 서버 전용 (브라우저로 전달되지 않음) ─────────
PORT=8787
# 관리자 계정. 비밀번호 해시는: npm run admin:hash -- '비밀번호'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# 세션 서명용 임의 문자열(32자 이상). 예: openssl rand -hex 32
SESSION_SECRET=
# 서버에서 이벤트 집계 저장 여부 (true일 때만 저장)
ANALYTICS_ENABLED=false
# 데이터 저장 위치 (기본 ./data/store)
DATA_DIR=
